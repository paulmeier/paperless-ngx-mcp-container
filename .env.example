# Copy to `.env` and fill in. Consumed by docker-compose.yml.

# Base URL of your Paperless-NGX instance (required).
PAPERLESS_URL=https://paperless.example.com

# Paperless-NGX API token (required).
# Create one in Paperless under: Settings -> (user menu) -> API Token.
PAPERLESS_API_KEY=your-api-token-here

# Optional: public-facing URL used when the server builds shareable document
# links (defaults to PAPERLESS_URL if unset).
# PAPERLESS_PUBLIC_URL=https://paperless.example.com

# Optional: transport + port. Defaults shown; usually no need to change these.
# MCP_TRANSPORT=http
# MCP_HTTP_PORT=3000
